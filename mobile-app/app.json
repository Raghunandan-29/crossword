{
  "expo": {
    "name": "Crossword Puzzle",
    "slug": "crossword-puzzle",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4263eb",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crossword.puzzle"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4263eb"
      },
      "package": "com.crossword.puzzle"
    },
    "extra": {
      "eas": {
        "projectId": "99a7c8d0-386a-4613-8d49-a3ca5cc8ffa8"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
